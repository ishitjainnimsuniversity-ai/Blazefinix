  <script>
    // Initialize Leaflet World Map
    const map = L.map('map').setView([13.0827, 80.2707], 3);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; NASA / ISRO OpenStreetMap'
    }).addTo(map);

    const satIcon = L.divIcon({
      className: 'custom-sat-icon',
      html: '<div style="font-size:24px; text-shadow:0 0 10px #00f0ff;">🛰️</div>',
      iconSize: [30, 30],
      iconAnchor: [15, 15]
    });

    const satMarker = L.marker([13.0827, 80.2707], { icon: satIcon }).addTo(map);
    const orbitPath = L.polyline([], { color: '#00f0ff', weight: 2, dashArray: '5, 10' }).addTo(map);

    // Chart.js Telemetry Graph
    const ctx = document.getElementById('telemetryChart').getContext('2d');
    const telemetryChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          { label: 'Temperature (°C)', borderColor: '#ff9900', data: [], tension: 0.3, fill: false },
          { label: 'Humidity (%)', borderColor: '#00f0ff', data: [], tension: 0.3, fill: false }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#94a3b8' } } },
        scales: {
          x: { display: false },
          y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } }
        }
      }
    });

    // Real-time polling
    async function updateTelemetry() {
      try {
        const res = await fetch('/api/telemetry');
        const data = await res.json();

        // Update Text Metrics
        document.getElementById('temp-val').innerText = data.temperature.toFixed(1);
        document.getElementById('hum-val').innerText = data.humidity.toFixed(0);
        document.getElementById('heatindex-val').innerText = data.heatIndex.toFixed(1);
        document.getElementById('dewpoint-val').innerText = data.dewPoint.toFixed(1);

        if (data.distance < 0) {
          document.getElementById('dist-val').innerText = "NO OBSTACLE";
          document.getElementById('prox-status').innerText = "CLEAR";
          document.getElementById('prox-status').style.color = "var(--accent-green)";
          document.getElementById('radar-blip').style.display = 'none';
        } else {
          document.getElementById('dist-val').innerText = data.distance.toFixed(1);
          document.getElementById('radar-blip').style.display = 'block';
          // Calculate blip position in radar circle
          let radius = Math.min(data.distance * 3, 90);
          document.getElementById('radar-blip').style.top = (110 - radius) + 'px';
          document.getElementById('radar-blip').style.left = '110px';

          if (data.distance <= 20) {
            document.getElementById('prox-status').innerText = "CRITICAL PROXIMITY";
            document.getElementById('prox-status').style.color = "var(--accent-red)";
          } else {
            document.getElementById('prox-status').innerText = "OBJECT IN RANGE";
            document.getElementById('prox-status').style.color = "var(--accent-orange)";
          }
        }

        // Update ML Scores
        let xgbPercent = Math.round(data.ml.xgboost * 100);
        let adaPercent = Math.round(data.ml.adaboost * 100);
        document.getElementById('xgb-score').innerText = xgbPercent + '%';
        document.getElementById('xgb-bar').style.width = xgbPercent + '%';
        document.getElementById('ada-score').innerText = adaPercent + '%';
        document.getElementById('ada-bar').style.width = adaPercent + '%';
        document.getElementById('threat-level').innerText = data.ml.threatLevel;
        document.getElementById('ml-conf').innerText = data.ml.confidence.toFixed(1) + '%';

        // Update Map
        satMarker.setLatLng([data.gps.lat, data.gps.lon]);
        orbitPath.addLatLng([data.gps.lat, data.gps.lon]);
        document.getElementById('sat-coords').innerText = `LAT: ${data.gps.lat.toFixed(4)}° | LON: ${data.gps.lon.toFixed(4)}° | ALT: ${data.gps.alt} km`;

        // Update Graph
        const now = new Date().toLocaleTimeString();
        if (telemetryChart.data.labels.length > 20) {
          telemetryChart.data.labels.shift();
          telemetryChart.data.datasets[0].data.shift();
          telemetryChart.data.datasets[1].data.shift();
        }
        telemetryChart.data.labels.push(now);
        telemetryChart.data.datasets[0].data.push(data.temperature);
        telemetryChart.data.datasets[1].data.push(data.humidity);
        telemetryChart.update();

      } catch (err) {
        console.error("Telemetry fetch error:", err);
      }
    }

    async function setServo(val) {
      document.getElementById('servo-angle-disp').innerText = val;
      document.getElementById('servoSlider').value = val;
      fetch('/api/servo?angle=' + val);
    }

    async function scanWiFi() {
      try {
        const res = await fetch('/api/scan');
        const data = await res.json();
        const tbody = document.querySelector('#wifi-table tbody');
        tbody.innerHTML = '';
        data.networks.forEach(net => {
          let row = `<tr>
            <td><strong>${net.ssid}</strong></td>
            <td>${net.rssi} dBm</td>
            <td>${net.enc}</td>
            <td style="color:${net.threat === 'SAFE' ? 'var(--accent-green)' : 'var(--accent-orange)'}">${net.threat}</td>
          </tr>`;
          tbody.innerHTML += row;
        });
      } catch (e) {
        console.error("Scan error:", e);
      }
    }

    setInterval(updateTelemetry, 1500);
    scanWiFi();
  </script>
</body>
</html>
)rawliteral";

// ================= API ENDPOINTS =================
void handleRoot() {
  server.send(200, "text/html", INDEX_HTML);
}

void handleTelemetryApi() {
  // Update Simulated Orbital Ground Track Progression
  satLon += 0.08;
  if (satLon > 180.0) satLon = -180.0;

  StaticJsonDocument<768> doc;
  doc["temperature"] = temperature;
  doc["humidity"] = humidity;
  doc["distance"] = distance;
  doc["heatIndex"] = heatIndex;
  doc["dewPoint"] = dewPoint;
  doc["servoAngle"] = currentServoPos;

  JsonObject gps = doc.createNestedObject("gps");
  gps["lat"] = satLat;
  gps["lon"] = satLon;
  gps["alt"] = satAlt;
  gps["speed"] = satSpeed;

  JsonObject ml = doc.createNestedObject("ml");
  ml["xgboost"] = currentML.xgboostAnomalyScore;
  ml["adaboost"] = currentML.adaboostThreatScore;
  ml["threatLevel"] = currentML.threatLevel;
  ml["anomalyClass"] = currentML.anomalyClass;
  ml["confidence"] = currentML.confidence;

  String jsonStr;
  serializeJson(doc, jsonStr);
  server.send(200, "application/json", jsonStr);
}

void handleScanApi() {
  int n = WiFi.scanNetworks();
  StaticJsonDocument<1024> doc;
  JsonArray networks = doc.createNestedArray("networks");

  for (int i = 0; i < n && i < 8; ++i) {
    JsonObject net = networks.createNestedObject();
    net["ssid"] = (WiFi.SSID(i).length() > 0) ? WiFi.SSID(i) : "[HIDDEN BEACON]";
    net["rssi"] = WiFi.RSSI(i);
    net["channel"] = WiFi.channel(i);
    
    String encType = "OPEN";
    String threat = "SAFE";
    switch (WiFi.encryptionType(i)) {
      case ENC_TYPE_WEP: encType = "WEP"; threat = "WEAK ENCRYPTION"; break;
      case ENC_TYPE_TKIP: encType = "WPA (TKIP)"; threat = "LEGACY CIPHER"; break;
      case ENC_TYPE_CCMP: encType = "WPA2 (AES)"; threat = "SAFE"; break;
      case ENC_TYPE_NONE: encType = "OPEN"; threat = "UNSECURED ACCESS"; break;
      case ENC_TYPE_AUTO: encType = "AUTO"; threat = "SAFE"; break;
    }
    net["enc"] = encType;
    net["threat"] = threat;
  }

  String output;
  serializeJson(doc, output);
  server.send(200, "application/json", output);
}

void handleServoApi() {
  if (server.hasArg("angle")) {
    int angle = server.arg("angle").toInt();
    angle = constrain(angle, 0, 180);
    currentServoPos = angle;
    satelliteServo.write(currentServoPos);
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Missing angle parameter");
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  // Initialize GPIO Pins
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(TRIG_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  // Initialize Sensors
  dht.begin();

  // Initialize I2C and LCD
  Wire.begin(D2, D1);
  lcd.init();
  lcd.backlight();

  // Initialize Servo
  satelliteServo.attach(SERVO_PIN);
  satelliteServo.write(servoNormal);

  // LCD Boot Banner
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("NASA-ISRO SAT");
  lcd.setCursor(0, 1);
  lcd.print("SYSTEM START...");
  delay(1500);

  // Start Wi-Fi Access Point + Station
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(ap_ssid, ap_pass);
  
  IPAddress apIP = WiFi.softAPIP();

  // Optional: try connecting to Station Wi-Fi
  if (strlen(sta_ssid) > 0 && strcmp(sta_ssid, "YOUR_WIFI_SSID") != 0) {
    WiFi.begin(sta_ssid, sta_pass);
  }

  // Setup Web Server Routes
  server.on("/", handleRoot);
  server.on("/api/telemetry", handleTelemetryApi);
  server.on("/api/scan", handleScanApi);
  server.on("/api/servo", handleServoApi);
  server.begin();

  // Show Station IP on LCD
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("MISSION CONTROL:");
  lcd.setCursor(0, 1);
  lcd.print(apIP);

  Serial.println();
  Serial.println("==================================================");
  Serial.println("  🚀 NASA - ISRO SATELLITE TELEMETRY STATION");
  Serial.println("==================================================");
  Serial.print("📡 Ground Station AP Wi-Fi: "); Serial.println(ap_ssid);
  Serial.print("🔑 AP Password: "); Serial.println(ap_pass);
  Serial.print("🌐 Mission Control Web URL: http://"); Serial.println(apIP);
  Serial.println("==================================================");
  delay(2000);
}

// ================= MAIN LOOP =================
void loop() {
  server.handleClient();

  unsigned long currentMillis = millis();

  // Read Sensors Every 1000ms
  if (currentMillis - lastSensorRead >= 1000) {
    lastSensorRead = currentMillis;

    float t = dht.readTemperature();
    float h = dht.readHumidity();
    float d = getDistance();

    if (!isnan(t)) temperature = t;
    if (!isnan(h)) humidity = h;
    distance = d;

    // Atmospheric calculations
    dewPoint = temperature - ((100.0 - humidity) / 5.0);
    heatIndex = -8.784695 + 1.61139411 * temperature + 2.338549 * humidity - 0.14611605 * temperature * humidity;

    // Run Embedded Machine Learning Inference
    evaluateMachineLearning();

    // Hardware Alert & Servo Logic
    bool tempAlert = (temperature >= temperatureLimit);
    bool distAlert = (distance >= 0 && distance <= distanceLimit);

    if (tempAlert || distAlert || currentML.xgboostAnomalyScore > 0.7f) {
      digitalWrite(LED_PIN, HIGH);
      satelliteServo.write(servoAlert);
    } else {
      digitalWrite(LED_PIN, LOW);
      satelliteServo.write(servoNormal);
    }

    // Print Telemetry to Serial
    Serial.println("----------------------------------------------");
    Serial.printf("🌡️ Temp: %.1f C | Hum: %.1f %% | Dist: %.1f cm\n", temperature, humidity, distance);
    Serial.printf("🤖 ML XGBoost Anomaly: %.1f %% | AdaBoost Threat: %.1f %%\n", currentML.xgboostAnomalyScore * 100.0f, currentML.adaboostThreatScore * 100.0f);
    Serial.printf("🛡️ Status: %s | Class: %s\n", currentML.threatLevel.c_str(), currentML.anomalyClass.c_str());
  }

  // Rotate LCD Info Screen Every 3000ms
  if (currentMillis - lastLcdUpdate >= 3000) {
    lastLcdUpdate = currentMillis;
    lcdPage = (lcdPage + 1) % 3;

    lcd.clear();
    if (lcdPage == 0) {
      // Screen 1: Primary Telemetry
      lcd.setCursor(0, 0);
      lcd.printf("T:%.1fC H:%.0f%%", temperature, humidity);
      lcd.setCursor(0, 1);
      if (distance < 0) lcd.print("D:No object");
      else lcd.printf("D:%.1fcm", distance);
    } else if (lcdPage == 1) {
      // Screen 2: Machine Learning Anomaly
      lcd.setCursor(0, 0);
      lcd.print("ML ANOMALY:");
      lcd.printf("%.0f%%", currentML.xgboostAnomalyScore * 100.0f);
      lcd.setCursor(0, 1);
      lcd.print(currentML.anomalyClass.substring(0, 16));
    } else {
      // Screen 3: Web Dashboard IP
      lcd.setCursor(0, 0);
      lcd.print("AP: NASA-ISRO");
      lcd.setCursor(0, 1);
      lcd.print("IP:192.168.4.1");
    }
  }
}

