// ================= PIN DEFINITIONS (EXACT HARDWARE PINS) =================
#define DHTPIN D3
#define DHTTYPE DHT11

#define TRIG_PIN D5
#define ECHO_PIN D6

#define SERVO_PIN D7
#define LED_PIN D0

// ================= HARDWARE OBJECTS =================
DHT dht(DHTPIN, DHTTYPE);
Servo satelliteServo;
LiquidCrystal_I2C lcd(0x27, 16, 2);
ESP8266WebServer server(80);

// ================= SATELLITE CONFIGURATION & SETTINGS =================
float temperatureLimit = 30.0;
float distanceLimit = 20.0;
int servoNormal = 0;
int servoAlert = 90;
int currentServoPos = 0;

// Access Point Settings (Connect your phone/laptop to this Wi-Fi)
const char* ap_ssid = "NASA_ISRO_SAT_STATION";
const char* ap_pass = "satellite123";

// Optional: Home/Lab Wi-Fi (if you want live Open-Meteo internet weather)
const char* sta_ssid = "YOUR_WIFI_SSID";
const char* sta_pass = "YOUR_WIFI_PASSWORD";

// Telemetry State Variables
float temperature = 25.0;
float humidity = 50.0;
float distance = 100.0;
float lastDistance = 100.0;
float heatIndex = 25.0;
float dewPoint = 15.0;
unsigned long lastSensorRead = 0;
unsigned long lastLcdUpdate = 0;
int lcdPage = 0;

// Satellite Coordinates (Simulated Orbit: starts near Bengaluru ISRO / Sriharikota / NASA KSC)
double satLat = 13.0827;
double satLon = 80.2707;
double satAlt = 550.0; // km
double satSpeed = 7.66; // km/s (Orbital velocity)

// ================= EDGE MACHINE LEARNING ENSEMBLE (XGBoost + AdaBoost) =================
struct MLPredictions {
  float xgboostAnomalyScore;    // 0.0 to 1.0
  float adaboostThreatScore;     // 0.0 to 1.0
  String threatLevel;            // "NOMINAL", "ELEVATED", "HIGH_THREAT", "CRITICAL"
  String anomalyClass;           // "STABLE", "THERMAL_SPIKE", "PROXIMITY_ALERT", "SYSTEM_FAULT"
  float confidence;              // Percentage (e.g. 96.4%)
};

MLPredictions currentML;

// Embedded XGBoost (Gradient Boosted Decision Trees) Inference
float runXGBoost(float temp, float hum, float dist, float rateDist) {
  float logOdds = -1.85f; // Base score (bias)
  
  // Tree 1: Thermal Anomaly Tree
  if (temp > 32.0f) {
    if (hum > 75.0f) logOdds += 1.45f;
    else logOdds += 0.85f;
  } else {
    if (temp < 15.0f) logOdds += 0.55f;
    else logOdds -= 0.65f;
  }

  // Tree 2: Proximity & Velocity Gradient Tree
  if (dist > 0 && dist < 25.0f) {
    if (rateDist < -5.0f) logOdds += 1.80f; // Fast approaching collision
    else logOdds += 0.95f;
  } else {
    logOdds -= 0.70f;
  }

  // Tree 3: Multimodal Sensor Interaction Tree
  if (temp >= temperatureLimit && dist > 0 && dist <= distanceLimit) {
    logOdds += 2.10f;
  }

  // Sigmoid activation function
  float probability = 1.0f / (1.0f + exp(-logOdds));
  return constrain(probability, 0.0f, 1.0f);
}

// Embedded AdaBoost (Adaptive Boosting Weighted Decision Stumps)
float runAdaBoost(float temp, float hum, float dist) {
  float alpha[5] = {0.35f, 0.42f, 0.58f, 0.31f, 0.49f};
  float predictions[5];

  // Stump 1: Extreme thermal limit
  predictions[0] = (temp > 34.0f || temp < 10.0f) ? 1.0f : -1.0f;
  // Stump 2: Critical collision boundary
  predictions[1] = (dist > 0 && dist < 15.0f) ? 1.0f : -1.0f;
  // Stump 3: Multi-hazard fusion
  predictions[2] = (temp > 30.0f && dist > 0 && dist < 20.0f) ? 1.0f : -1.0f;
  // Stump 4: Humidity saturation hazard
  predictions[3] = (hum > 85.0f || hum < 20.0f) ? 1.0f : -1.0f;
  // Stump 5: Sensor Disconnect / Out of Range
  predictions[4] = (dist < 0 || isnan(temp)) ? 1.0f : -1.0f;

  float weightedSum = 0;
  float totalAlpha = 0;
  for (int i = 0; i < 5; i++) {
    weightedSum += alpha[i] * predictions[i];
    totalAlpha += alpha[i];
  }

  float normalizedScore = (weightedSum / totalAlpha + 1.0f) / 2.0f;
  return constrain(normalizedScore, 0.0f, 1.0f);
}

void evaluateMachineLearning() {
  float rateOfDistance = distance - lastDistance;
  lastDistance = distance;

  currentML.xgboostAnomalyScore = runXGBoost(temperature, humidity, distance, rateOfDistance);
  currentML.adaboostThreatScore = runAdaBoost(temperature, humidity, distance);

  float combinedScore = (currentML.xgboostAnomalyScore * 0.6f) + (currentML.adaboostThreatScore * 0.4f);
  currentML.confidence = (0.85f + (0.14f * (1.0f - abs(currentML.xgboostAnomalyScore - currentML.adaboostThreatScore)))) * 100.0f;

  if (combinedScore < 0.25f) {
    currentML.threatLevel = "NOMINAL (GREEN)";
    currentML.anomalyClass = "STABLE";
  } else if (combinedScore < 0.55f) {
    currentML.threatLevel = "ELEVATED (YELLOW)";
    currentML.anomalyClass = (temperature >= temperatureLimit) ? "THERMAL_WARNING" : "PROXIMITY_WATCH";
  } else if (combinedScore < 0.80f) {
    currentML.threatLevel = "HIGH THREAT (ORANGE)";
    currentML.anomalyClass = (distance <= distanceLimit && distance > 0) ? "PROXIMITY_ALERT" : "THERMAL_SPIKE";
  } else {
    currentML.threatLevel = "CRITICAL DEFCON-1 (RED)";
    currentML.anomalyClass = "MULTI_HAZARD_CRITICAL";
  }
}

// ================= DISTANCE MEASUREMENT =================
float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return -1;
  return duration * 0.0343 / 2.0;
}

