# Database Connection String (PostgreSQL or SQLite for local dev)
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For SQLite dev: file:./dev.db
DATABASE_URL="file:./dev.db"

# Anthropic Claude API Configuration (Server-side only)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Authentication & Session Secrets
NEXTAUTH_SECRET="loop-demo-secret-key-change-in-production-32char-min"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
