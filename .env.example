# ============================================================================
# LOOP Platform — Environment Configuration Template
# ============================================================================

# Authoritative PostgreSQL Database URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/loop_db?schema=public"

# Anthropic Claude API Key (Server-side zero-shot classification & report generation)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Session & Security Secret
NEXTAUTH_SECRET="loop-production-secret-key-32chars-minimum-entropy"
NEXTAUTH_URL="http://localhost:3000"

# Development authentication flag (set to "false" in production)
ENABLE_DEV_AUTH="false"
NODE_ENV="development"
